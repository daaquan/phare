APP_NAME=Skeleton
# Production must run with APP_ENV=production and APP_DEBUG=false.
# config/app.php forces debug off whenever APP_ENV=production.
APP_ENV=production
APP_VER=dev
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja

APP_URL=https://api.test

LOG_CHANNEL=single
LOG_SLACK_WEBHOOK_URL=
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=json

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Session cookie flags (config/session.php). Secure needs HTTPS; set it to
# false only for plain-http local development.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Proxies whose forwarded client-IP headers are trusted (comma separated).
# phpfan.net: cloudflared -> nginx (loopback) -> php-fpm.
TRUSTED_PROXIES=127.0.0.1,::1

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_HOST=redis
# Always set a password in production
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcasting (Laravel Echo equivalent / Soketi)
# Locally, start Soketi over http: npx @soketi/soketi start
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_USE_TLS=false

# The frontend (Vite) reads the same values through the VITE_ prefix
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
