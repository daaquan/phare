parameters:
    level: 5
    paths:
        - app
        - database
        - config
        - routes
    scanFiles:
        # Global facade aliases (App, Auth, ID, ...) are registered at runtime
        # from config/app.php `aliases`; this file declares them for analysis.
        - _ide_helper.php
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false
