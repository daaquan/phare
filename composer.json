{
    "name": "phox/phox",
    "description": "A Phox starter project.",
    "type": "project",
    "keywords": [
        "phalcon",
        "laravel",
        "framework",
        "api"
    ],
    "homepage": "https://github.com/daaquan/phox",
    "support": {
        "issues": "https://github.com/daaquan/phox/issues",
        "source": "https://github.com/daaquan/phox"
    },
    "repositories": {
        "phox/framework": {
            "type": "vcs",
            "url": "https://github.com/daaquan/framework.git"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "phox/framework": "dev-main",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/phpinsights": "^2.11",
        "pestphp/pest": "^2.36",
        "pestphp/pest-plugin-faker": "^2.0",
        "phalcon/ide-stubs": "^5.8",
        "roave/security-advisories": "dev-latest",
        "spatie/pest-plugin-test-time": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
