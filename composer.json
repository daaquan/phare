{
    "name": "phox/phox",
    "description": "A Phox starter project.",
    "type": "project",
    "keywords": [
        "phalcon",
        "laravel",
        "framework",
        "api"
    ],
    "homepage": "https://github.com/daaquan/phox",
    "support": {
        "issues": "https://github.com/daaquan/phox/issues",
        "source": "https://github.com/daaquan/phox"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/daaquan/framework.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:daaquan/chronos.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:daaquan/sqids.git"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.4",
        "phox/framework": "dev-main",
        "symfony/console": "^7.3",
        "chronos/chronos-ext": "dev-main",
        "sqids/sqids-ext": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.22",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-faker": "^3.0",
        "roave/security-advisories": "dev-latest"
    }
}
