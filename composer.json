{
    "name": "g/skeleton",
    "description": "Game framework with Phalcon",
    "type": "library",
    "keywords": [
        "phalcon",
        "framework",
        "skeleton"
    ],
    "homepage": "http://projectg-portal:10080/g/skeleton",
    "support": {
        "issues": "http://projectg-portal:10080/g/skeleton/issues",
        "source": "http://projectg-portal:10080/g/skeleton"
    },
    "repositories": {
        "g/framework": {
            "type": "vcs",
            "url": "http://10.2.2.84/shosen.cho/framework.git"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-msgpack": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-phalcon": "~5.1",
        "ext-redis": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "g/framework": "dev-main",
        "symfony/console": "^6.2"
    },
    "require-dev": {
        "nunomaduro/phpinsights": "^2.6",
        "pestphp/pest": "^1.22",
        "pestphp/pest-plugin-faker": "^1.0",
        "pestphp/pest-plugin-parallel": "^1.2",
        "phalcon/ide-stubs": "^5.1",
        "spatie/pest-plugin-test-time": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
