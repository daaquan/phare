{
    "name": "g/skeleton",
    "description": "A skeleton project for a game API.",
    "type": "library",
    "keywords": [
        "phalcon",
        "framework",
        "skeleton"
    ],
    "homepage": "http://projectg-portal:10080/g/skeleton",
    "support": {
        "issues": "http://projectg-portal:10080/g/skeleton/issues",
        "source": "http://projectg-portal:10080/g/skeleton"
    },
    "repositories": {
        "g/framework": {
            "type": "vcs",
            "url": "http://10.2.2.84/shosen.cho/framework.git"
        },
        "sqids/sqids-ext": {
            "type": "vcs",
            "url": "http://10.2.2.84/shosen.cho/sqids-ext.git"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-phalcon": "~5.4",
        "ext-redis": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "g/framework": "dev-main",
        "pda/pheanstalk": "^5.0",
        "symfony/console": "^6.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/phpinsights": "^2.8",
        "pestphp/pest": "^2.23",
        "pestphp/pest-plugin-faker": "^2.0",
        "phalcon/ide-stubs": "^5.1",
        "spatie/pest-plugin-test-time": "^2.0",
        "sqids/sqids-ext": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
