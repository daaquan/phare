{
    "name": "phox/phox",
    "description": "A Phox starter project.",
    "type": "library",
    "keywords": [
        "phalcon",
        "framework",
        "skeleton"
    ],
    "homepage": "https://github.com/daaquan/phox",
    "support": {
        "issues": "https://github.com/daaquan/phox/issues",
        "source": "https://github.com/daaquan/phox"
    },
    "repositories": {
        "phox/framework": {
            "type": "vcs",
            "url": "https://github.com/daaquan/framework.git"
        },
        "sqids/sqids-ext": {
            "type": "vcs",
            "url": "https://github.com/daaquan/sqids.git"
        },
        "chronos/chronos-ext": {
            "type": "vcs",
            "url": "https://github.com/daaquan/chronos.git"
        },
        "phalcon/ide-stubs": {
            "type": "vcs",
            "url": "https://github.com/daaquan/cphalcon-ide-stubs.git"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-phalcon": "~5.4",
        "ext-redis": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "chronos/chronos-ext": "dev-main",
        "google/protobuf": "^3.25",
        "pda/pheanstalk": "^5.0",
        "phox/framework": "dev-main",
        "sqids/sqids-ext": "dev-main",
        "symfony/console": "^6.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/phpinsights": "^2.8",
        "pestphp/pest": "^2.23",
        "pestphp/pest-plugin-faker": "^2.0",
        "phalcon/ide-stubs": "dev-master",
        "spatie/pest-plugin-test-time": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
