{
    "name": "phare/phare",
    "description": "A Phare starter project.",
    "type": "project",
    "keywords": [
        "phalcon",
        "laravel",
        "framework",
        "api"
    ],
    "homepage": "https://github.com/daaquan/phare",
    "support": {
        "issues": "https://github.com/daaquan/phare/issues",
        "source": "https://github.com/daaquan/phare"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/daaquan/framework.git"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "phare/framework": "dev-main",
        "symfony/console": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "secure-http": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "dev-main",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-faker": "^4.0",
        "roave/security-advisories": "dev-latest"
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npm run dev",
            "php artisan serve",
            "php artisan queue:work"
        ]
    }
}